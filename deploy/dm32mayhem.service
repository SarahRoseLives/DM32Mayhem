# SPDX-License-Identifier: MIT
[Unit]
Description=DM32Mayhem web flasher (dm32mayhem.com)
Documentation=https://github.com/SarahRoseLives/DM32Mayhem
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dm32mayhem
Group=dm32mayhem
ExecStart=/opt/dm32mayhem/dm32mayhem-web -domain dm32mayhem.com -email sarahroselives@protonmail.com -cache /var/lib/dm32mayhem/autocert
Restart=on-failure
RestartSec=5s
StateDirectory=dm32mayhem
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077

[Install]
WantedBy=multi-user.target
